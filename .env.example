# Self-hosting: see SELF_HOSTING.md. Never commit .env.
APP_ORIGIN=https://just-html-dprevozniks-projects.vercel.app

# Standard Postgres (Neon, PlanetScale, etc.). TLS enabled by default.
DATABASE_URL=
# Legacy alias supported when DATABASE_URL is unset:
PLANETSCALE_URL=

# Your Resend account and verified sending domain:
RESEND_API_KEY=
RESEND_FROM=Documents <login@notify.example.com>
